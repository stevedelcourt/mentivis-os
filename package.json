{
  "name": "mentivis-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "og": "python3 scripts/generate-og-images.py",
    "og:check": "python3 scripts/generate-og-images.py --check",
    "prebuild": "command -v python3 >/dev/null && python3 scripts/generate-og-images.py || echo '[og] python3 missing, skipping OG generation'",
    "build": "node scripts/build.mjs",
    "check": "node scripts/check-static-export.mjs",
    "preview": "npx --yes serve out -l 3007",
    "referentiel:import": "node scripts/import-referentiel-2026-09.mjs",
    "content:export": "node scripts/export-cms-content.mjs",
    "content:import-db": "python3 scripts/export-db-content.py",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .next out",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "lucide-react": "^1.14.0",
    "marked": "^15.0.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "vanilla-cookieconsent": "^3.1.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "jsdom": "^26.0.0",
    "typescript": "^5",
    "vitest": "^3.0.0"
  }
}
